        <mxCell id="ezDyulbhmOV09phdkB_l-13" parent="ezDyulbhmOV09phdkB_l-1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;strokeColor=#6F0000;strokeWidth=1;arcSize=18;fontSize=13;fontColor=#ffffff;fillColor=#a20025;" value="Local Query Keywords&lt;div&gt;low-level&lt;/div&gt;" vertex="1">
