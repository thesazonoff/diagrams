        </mxCell>
        <mxCell id="WrTDcAN2iTQWK-d_IRSW-70" edge="1" parent="1" source="WrTDcAN2iTQWK-d_IRSW-8" style="edgeStyle=orthogonalEdgeStyle;shape=connector;curved=0;rounded=1;sketch=1;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPadding=0 4;startSize=8;endArrow=blockThin;endFill=1;endSize=8;" target="WrTDcAN2iTQWK-d_IRSW-69">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WrTDcAN2iTQWK-d_IRSW-71" edge="1" parent="1" source="WrTDcAN2iTQWK-d_IRSW-9" style="edgeStyle=orthogonalEdgeStyle;shape=connector;curved=0;rounded=1;sketch=1;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPadding=0 4;startSize=8;endArrow=blockThin;endFill=1;endSize=8;" target="WrTDcAN2iTQWK-d_IRSW-69">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WrTDcAN2iTQWK-d_IRSW-73" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.database;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" value="KV и DOC Status&lt;div&gt;Storage&lt;/div&gt;" vertex="1">
          <mxGeometry height="124" width="133" x="-100" y="178" as="geometry" />
        </mxCell>
        <mxCell id="WrTDcAN2iTQWK-d_IRSW-74" edge="1" parent="1" source="rTkv0_UGOf3wEzf9HFxA-4" style="edgeStyle=orthogonalEdgeStyle;shape=connector;curved=0;rounded=1;sketch=1;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPadding=0 4;startSize=8;endArrow=blockThin;endFill=1;endSize=8;" target="WrTDcAN2iTQWK-d_IRSW-73">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WrTDcAN2iTQWK-d_IRSW-75" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&amp;nbsp;в KV Storage запишется:&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;text_chunks &lt;/b&gt;-&amp;nbsp;Сразу после разбиения документа на чанки, до LLM-извлечения: Текст каждого чанка, его размер, порядковый номер, ID родительского документа и другие метаданные.&lt;/li&gt;&lt;li&gt;&lt;b&gt;llm_response_cache&amp;nbsp;&lt;/b&gt;-&amp;nbsp;После каждого LLM-вызова при извлечении сущностей и отношений:&amp;nbsp;Сырой ответ модели по чанку: извлечённые сущности, отношения, их описания; используется как кеш, чтобы не повторять одинаковые LLM-запросы.&lt;/li&gt;&lt;li&gt;&lt;b&gt;doc_status &lt;/b&gt;-&amp;nbsp; В нём LightRAG отслеживает жизненный цикл документа: принят, обрабатывается, обработан, ошибка, частично обработан&lt;/li&gt;&lt;li&gt;&lt;b&gt;full_docs &lt;/b&gt;- на этапе индексации после приема документа: Полный исходный документ и его ID&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="1080" x="-840" y="30" as="geometry" />
        </mxCell>
        <mxCell id="WrTDcAN2iTQWK-d_IRSW-77" edge="1" parent="1" source="rTkv0_UGOf3wEzf9HFxA-10" style="edgeStyle=orthogonalEdgeStyle;shape=connector;curved=0;rounded=1;sketch=1;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPadding=0 4;startSize=8;endArrow=blockThin;endFill=1;endSize=8;" target="WrTDcAN2iTQWK-d_IRSW-73">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WrTDcAN2iTQWK-d_IRSW-79" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="В векторную БД сохраняются вектора с описанием связей между сущностями, которые соединяют исходные и целевые сущности по их идентификаторам&amp;nbsp;&amp;nbsp;" vertex="1">
          <mxGeometry height="235" width="430" x="650" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="WrTDcAN2iTQWK-d_IRSW-80" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;fontSize=16;" value="В векторную БД сохраняются вектора с описанием сущностей, извлеченных из текстовых фрагментов, с уникальным идентификатором, названием сущности..&amp;nbsp;&amp;nbsp;" vertex="1">
          <mxGeometry height="235" width="430" x="-270" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="WrTDcAN2iTQWK-d_IRSW-81" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="Сохранение созданного индекса графа" vertex="1">
          <mxGeometry height="40" width="310" x="277" y="1268" as="geometry" />
        </mxCell>
        <mxCell id="aU-IUn3Gahu5CdIWcQVS-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;" value="&lt;b&gt;Инкрементальное обновление графа&lt;/b&gt;&lt;div&gt;Новые документы добавляются в существующий граф без полной переиндексации. После извлечения сущностей и связей обновляются ответы LLM в llm_response_cache и включает в них все новые сущности и связи без каких либо конфликтов и дублирования существующих данных.&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="1317" x="603" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
