        </mxCell>
        <mxCell id="xF6-G2FUlcj3n8iHAl7S-19" parent="ezDyulbhmOV09phdkB_l-1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;strokeColor=#6F0000;strokeWidth=1;arcSize=18;fontSize=13;fontColor=#ffffff;fillColor=#a20025;" value="LLM: генерация ответа" vertex="1">
          <mxGeometry height="60" width="196" x="324" y="1480" as="geometry" />
        </mxCell>
        <mxCell id="xF6-G2FUlcj3n8iHAl7S-21" parent="ezDyulbhmOV09phdkB_l-1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;strokeColor=#6F0000;strokeWidth=1;arcSize=18;fontSize=13;fontColor=#ffffff;fillColor=#a20025;" value="Generated Answer" vertex="1">
          <mxGeometry height="60" width="196" x="324" y="1608" as="geometry" />
        </mxCell>
        <mxCell id="xF6-G2FUlcj3n8iHAl7S-23" parent="ezDyulbhmOV09phdkB_l-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;b&gt;Дальнейшая логика поиска зависит от выбранного режима:&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;naive&amp;nbsp;&lt;/b&gt;стандартный векторный поиск по чанкам, без обхода графа.&lt;/li&gt;&lt;li&gt;&lt;b&gt;local&amp;nbsp;&lt;/b&gt;обход ближайшего окружения (локальный уровень) – конкретных сущностей из низкоуровневых ключей. Для точечных фактологических вопросов.&amp;nbsp;&lt;/li&gt;&lt;li&gt;&lt;b&gt;global&amp;nbsp;&lt;/b&gt;&quot;высокоуровневый&quot; поиск по всему графу: обход по общим концепциям и отношениям, связанным в кластеры. Для аналитических и обобщающих вопросов.&lt;/li&gt;&lt;li&gt;&lt;b&gt;hybrid&amp;nbsp;&lt;/b&gt;объединение local и global. Для многоаспектных и сложных вопросов.&lt;/li&gt;&lt;li&gt;&lt;b&gt;mix&amp;nbsp;&lt;/b&gt;интеграция полного графового поиска (hybrid) с векторным поиском по чанкам с последующим взвешенным слиянием результатов. Наиболее полный режим&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;В наиболее полном режиме &lt;b&gt;mix &lt;/b&gt;фактически выполняются три параллельных процесса: обход графа от выявленных конкретных сущностей, обход от связанных концептов и стандартный векторный поиск по чанкам. Полученные результаты объединяются в единый контекст, передаваемый LLM для генерации ответа&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="740" x="820" y="100" as="geometry" />
        </mxCell>
        <mxCell id="MBiauGgocSSx0svK0mwj-0" parent="ezDyulbhmOV09phdkB_l-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=10;align=center;fillColor=#d5e8d4;strokeColor=#82b366;shadow=0;glass=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Use LLM&lt;/h1&gt;" vertex="1">
          <mxGeometry height="40" width="98" x="169" y="565" as="geometry" />
