        <mxCell id="WrTDcAN2iTQWK-d_IRSW-24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;strokeColor=#6F0000;strokeWidth=1;arcSize=18;fontSize=13;fontColor=#ffffff;fillColor=#a20025;" value="Value V Vector" vertex="1">
          <mxGeometry height="40" width="120" x="1256" y="800" as="geometry" />
        </mxCell>
