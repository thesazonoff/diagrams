        </mxCell>
        <mxCell id="eIx_uYKYx1aZ3_7NMLOX-4" edge="1" parent="ezDyulbhmOV09phdkB_l-1" source="ezDyulbhmOV09phdkB_l-15" style="edgeStyle=orthogonalEdgeStyle;shape=connector;curved=0;rounded=1;sketch=1;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPadding=0 4;startSize=8;endArrow=blockThin;endFill=1;endSize=8;" target="_JSfR8M_rK7nQcscP5dH-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ezDyulbhmOV09phdkB_l-15" parent="ezDyulbhmOV09phdkB_l-1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;strokeColor=#6F0000;strokeWidth=1;arcSize=18;fontSize=13;fontColor=#ffffff;fillColor=#a20025;" value="Global Query Keywords&lt;div&gt;high-level&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="196" x="694" y="640" as="geometry" />
        </mxCell>
        <mxCell id="xF6-G2FUlcj3n8iHAl7S-0" parent="ezDyulbhmOV09phdkB_l-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="LightRAG использует стратегию двухуровнего поиска. При обработке запроса LLM выделяет из него два набора ключевых слов:&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;низкоуровневые &lt;/b&gt;(low_level_keywords) – конкретные именованные сущности и факты, т.е.&amp;nbsp;поиск конкретной, детализированной информации по отдельным узлам и связям для обработки локальных запросов.&lt;/li&gt;&lt;li&gt;&lt;b&gt;высокоуровневые &lt;/b&gt;(high_level_keywords) – обобщенные темы и концепции, т.е.&amp;nbsp;объединяет информацию из нескольких источников в разных документах для ответа на глобальные запросы, требующие более широкого охвата или абстракции&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;В этом суть того, что авторы называют &quot;dual‑level retrieval system&quot;: система одновременно понимает, что спрашивает пользователь, и о чем этот вопрос в более широком контексте&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="740" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="xF6-G2FUlcj3n8iHAl7S-4" edge="1" parent="ezDyulbhmOV09phdkB_l-1" source="xF6-G2FUlcj3n8iHAl7S-1" style="edgeStyle=orthogonalEdgeStyle;shape=connector;curved=0;rounded=1;sketch=1;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPadding=0 4;startSize=8;endArrow=blockThin;endFill=1;endSize=8;" target="ezDyulbhmOV09phdkB_l-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xF6-G2FUlcj3n8iHAl7S-1" parent="ezDyulbhmOV09phdkB_l-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=13;fontColor=#16294D;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;dual‑level retrieval system&lt;/h1&gt;" vertex="1">
